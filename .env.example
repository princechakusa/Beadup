# Copy to .env.local (never commit real values)
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # https://beadup.app in production
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only
ANTHROPIC_API_KEY=              # server only
STRIPE_SECRET_KEY=              # server only (sk_test_... in development)
STRIPE_WEBHOOK_SECRET=          # server only, platform webhook endpoint
STRIPE_CONNECT_WEBHOOK_SECRET=  # server only, Connect webhook endpoint
TWILIO_ACCOUNT_SID=             # server only
TWILIO_AUTH_TOKEN=              # server only
TWILIO_MESSAGING_SERVICE_SID=   # server only, 10DLC-registered Messaging Service (MG...)
CRON_SECRET=                    # server only, 32+ random chars; guards /api/cron/*
EXPO_ACCESS_TOKEN=              # server only, optional (Expo enhanced push security)
# Cloudflare Turnstile (bot protection on booking pages). For local testing,
# Cloudflare's published always-pass test keys are:
#   site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=           # server only
# RevenueCat (Pro in-app subscriptions)
REVENUECAT_SECRET_KEY=          # server only (sk_...), reads subscriber entitlements
REVENUECAT_WEBHOOK_AUTH=        # server only, 24+ chars; set the same value as the webhook Authorization header in RevenueCat
