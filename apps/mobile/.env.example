# Copy to .env.local. Only public values belong here: anything EXPO_PUBLIC_*
# ships inside the app bundle. Server secrets never go in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=          # e.g. http://<your-LAN-IP>:54321 for local Supabase on a device
EXPO_PUBLIC_SUPABASE_ANON_KEY=     # public anon / publishable key (RLS protects data)
EXPO_PUBLIC_API_URL=               # web app origin, e.g. http://<your-LAN-IP>:3000 or https://beadup.app
